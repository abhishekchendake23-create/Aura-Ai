# Environment variables for Aura AI.
# Enter your GEMINI_API_KEY, OPENROUTER_API_KEY, DEEPSEEK_API_KEY, GROQ_API_KEY, and EXA_API_KEY in the Secrets panel in AI Studio (or via .env / GitHub Secrets).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
EXA_API_KEY=YOUR_EXA_API_KEY
